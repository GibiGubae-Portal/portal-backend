# --- Database (Neon) ---------------------------------------------------------
# Pooled connection (host contains "-pooler"), used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (non-pooled) connection, used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Auth --------------------------------------------------------------------
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=
# Admin usernames that get super-admin rights (JSON array or comma-separated).
SUPER_ADMINS='["Super Admin"]'

# --- CORS --------------------------------------------------------------------
# Frontend origin(s), comma-separated. Not needed when the frontend proxies /api.
FRONTEND_URL=https://6kilogbigubae.vercel.app
# CORS_ORIGINS=https://preview.example.com

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5500
# DB_POOL_MAX=5
# LOGIN_RATE_LIMIT=10

# --- Seeding (npm run db:seed) ----------------------------------------------
# SUPER_ADMIN_USERNAME=Super Admin       # must be listed in SUPER_ADMINS
# SUPER_ADMIN_STUDENT_ID=SUPER-ADMIN     # login ID
# SUPER_ADMIN_PASSWORD=                  # omit to generate one (printed once)

# --- Tests -------------------------------------------------------------------
# A SEPARATE database for integration tests (e.g. neondb_test). Required to run
# them; they never touch DATABASE_URL. Each run uses a throwaway test_* schema.
# TEST_DATABASE_URL=
